{
  "expo": {
    "name": "BloodBank",
    "slug": "bloodbank",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bloodbank-icon.png",
    "scheme": "bloodbank",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.bloodbank.mobile",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#BC2846",
        "foregroundImage": "./assets/images/bloodbank-icon.png"
      },
      "package": "com.bloodbank.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/bloodbank-icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BloodBank uses your approximate location to find nearby compatible blood requests. Your home location is never shared."
        }
      ],
      ["expo-notifications", { "color": "#BC2846", "defaultChannel": "blood-requests" }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF8F6",
          "image": "./assets/images/bloodbank-icon.png",
          "imageWidth": 100
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
