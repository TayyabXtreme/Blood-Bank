{
  "expo": {
    "name": "Blood Bank",
    "slug": "blood-bank",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/auth/blood-drop.png",
    "scheme": "bloodbank",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fff8f5",
        "foregroundImage": "./assets/auth/blood-drop.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/auth/blood-drop.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fff8f5",
          "image": "./assets/auth/blood-drop.png",
          "imageWidth": 99
        }
      ],
      ["expo-location", { "locationWhenInUsePermission": "Blood Bank uses your location to suggest your city. You can also enter it manually." }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
