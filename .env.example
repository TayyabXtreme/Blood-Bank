# Demo works without credentials. Explicitly switch to live after configuring services.
EXPO_PUBLIC_APP_MODE=demo
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# SERVER ONLY: set in the Convex dashboard or with npx convex env set.
# BETTER_AUTH_SECRET=<generate at least 32 random characters>
# SITE_URL=http://localhost:8081
# RESEND_API_KEY=<required for password reset and verification email>
# AUTH_EMAIL_FROM=BloodBank <no-reply@your-verified-domain.com>
# DEEPSEEK_API_KEY=<optional, AI failure never blocks requests>
# EXPO_ACCESS_TOKEN=<optional, if Expo push access-token security is enabled>
