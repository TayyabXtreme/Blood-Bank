# Client: use your laptop Wi-Fi IPv4 address for Expo Go, or a Convex cloud URL.
EXPO_PUBLIC_CONVEX_URL=http://YOUR_WIFI_IPV4:3210
EXPO_PUBLIC_CONVEX_SITE_URL=http://YOUR_WIFI_IPV4:3211

# Configure these in the Convex deployment with `npx convex env set`, not in Expo.
# DEMO_MODE=true enables isolated sample accounts; leave it disabled in production.
# DEEPSEEK_API_KEY= optional request summaries
# EXPO_ACCESS_TOKEN= optional Expo push-service authorization
# Authentication provider secrets will be configured when sign-in is enabled.
